<UserControl x:Class="FinanceTracker.wpf.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:FinanceTracker.wpf.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="250">

    <UserControl.Resources>
        <conv:BalanceToBrushConverter x:Key="BalanceToBrushConverter"/>
    </UserControl.Resources>

    <Border Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="0,0,1,0">
        <Grid Margin="16,20,16,16">
            <Grid.RowDefinitions>
                <!-- Логотип і назва -->
                <RowDefinition Height="Auto"/>
                <!-- Меню навігації -->
                <RowDefinition Height="Auto"/>
                <!-- Розділювач -->
                <RowDefinition Height="Auto"/>
                <!-- Список рахунків -->
                <RowDefinition Height="*"/>
                <!-- Нижня панель: Експорт -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Логотип бренду -->
            <StackPanel Grid.Row="0" Margin="4,0,4,22">
                <DockPanel LastChildFill="True">
                    <Border Width="38" Height="38"
                            Background="#4F46E5"
                            CornerRadius="9"
                            Margin="0,0,10,0"
                            DockPanel.Dock="Left">
                        <!-- SVG Іконка гаманця -->
                        <Path Data="{StaticResource GeoWallet}"
                              Fill="White"
                              Width="18" Height="18"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Finance"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Foreground="#0F172A"/>
                            <TextBlock Text="Tracker"
                                       FontWeight="Medium"
                                       FontSize="16"
                                       Foreground="#4F46E5"/>
                            <Border Background="#EEF2FF"
                                    CornerRadius="4"
                                    Padding="5,1"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="v2.0"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#4F46E5"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Особистий бюджет"
                                   FontSize="11"
                                   Foreground="#64748B"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <!-- Меню навігації -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <TextBlock Text="НАВІГАЦІЯ"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#94A3B8"
                           Margin="8,0,0,8"/>

                <!-- Кнопка 1: Дашборд -->
                <Button Command="{Binding SetTabDashboardCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDashboardTab}" Value="True">
                                    <Setter Property="Background" Value="#EEF2FF"/>
                                    <Setter Property="Foreground" Value="#4F46E5"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <DockPanel LastChildFill="True">
                        <Path Data="{StaticResource GeoDashboard}"
                              Width="15" Height="15"
                              Stretch="Uniform"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="#64748B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDashboardTab}" Value="True">
                                            <Setter Property="Fill" Value="#4F46E5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Text="Дашборд" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>

                <!-- Кнопка 2: Транзакції -->
                <Button Command="{Binding SetTabTransactionsCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTransactionsTab}" Value="True">
                                    <Setter Property="Background" Value="#EEF2FF"/>
                                    <Setter Property="Foreground" Value="#4F46E5"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <DockPanel LastChildFill="True">
                        <Path Data="{StaticResource GeoTransactions}"
                              Width="15" Height="15"
                              Stretch="Uniform"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="#64748B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTransactionsTab}" Value="True">
                                            <Setter Property="Fill" Value="#4F46E5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Text="Транзакції" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>

                <!-- Кнопка 3: Аналітика -->
                <Button Command="{Binding SetTabAnalyticsCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAnalyticsTab}" Value="True">
                                    <Setter Property="Background" Value="#EEF2FF"/>
                                    <Setter Property="Foreground" Value="#4F46E5"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <DockPanel LastChildFill="True">
                        <Path Data="{StaticResource GeoAnalytics}"
                              Width="15" Height="15"
                              Stretch="Uniform"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="#64748B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAnalyticsTab}" Value="True">
                                            <Setter Property="Fill" Value="#4F46E5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Text="Аналітика та звіти" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
            </StackPanel>

            <!-- Розділювач -->
            <Separator Grid.Row="2" Background="#E2E8F0" Margin="0,0,0,14"/>

            <!-- Блок «Мої рахунки» -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="МОЇ РАХУНКИ"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#94A3B8"
                           Margin="8,0,0,8"/>

                <!-- Список рахунків -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                    <ItemsControl ItemsSource="{Binding AccountBalances}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC"
                                        BorderBrush="#F1F5F9"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="10,7"
                                        Margin="0,0,0,6">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="#334155"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Balance, StringFormat='{}{0:N2} ₴'}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{Binding Balance, Converter={StaticResource BalanceToBrushConverter}}"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Картка загального балансу в сайдбарі -->
                <Border Grid.Row="2"
                        Background="#EEF2FF"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Загальний баланс"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="#4F46E5"/>
                        <TextBlock Text="{Binding TotalBalance, StringFormat='{}{0:N2} ₴'}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#1E1B4B"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Нижня кнопка: Експорт CSV -->
            <Button Grid.Row="4"
                    Style="{StaticResource PeriodButtonStyle}"
                    Command="{Binding ExportCsvCommand}"
                    Height="36"
                    Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Data="{StaticResource GeoDownload}"
                          Fill="#475569"
                          Width="14" Height="14"
                          Stretch="Uniform"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"/>
                    <TextBlock Text="Експорт в CSV"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
