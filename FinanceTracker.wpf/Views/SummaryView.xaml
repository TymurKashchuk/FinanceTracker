<UserControl x:Class="FinanceTracker.wpf.Views.SummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:FinanceTracker.wpf.ViewModels"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             d:DesignHeight="600" d:DesignWidth="950">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,4,0,16">
            <Grid.RowDefinitions>
                <!-- Верхні картки підсумків -->
                <RowDefinition Height="Auto"/>
                <!-- Двоколонковий блок: Таблиця топ витрат + Діаграма -->
                <RowDefinition Height="Auto"/>
                <!-- 3. Блок місячних бюджетів -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Верхні інформаційні плашки -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Картка: Найбільша категорія витрат -->
                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,14"
                        Margin="0,0,8,0">
                    <DockPanel LastChildFill="True">
                        <!-- Іконка стрілки вниз -->
                        <Border Width="34" Height="34"
                                Background="#FEF2F2"
                                CornerRadius="8"
                                Margin="0,0,12,0"
                                DockPanel.Dock="Left">
                            <Path Data="{StaticResource GeoArrowDown}"
                                  Fill="#EF4444"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Найбільша категорія витрат"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="#64748B"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding TopExpenseCategoryName}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="#0F172A"/>
                                <TextBlock Text=" — "
                                           Foreground="#94A3B8"
                                           Margin="6,0"/>
                                <TextBlock Text="{Binding TopExpenseCategoryAmount, StringFormat='{}{0:N2} ₴'}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="#EF4444"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Картка: Загальна кількість операцій -->
                <Border Grid.Column="1"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,14"
                        Margin="8,0,0,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Кількість операцій"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="#64748B"/>
                        <TextBlock Text="{Binding TransactionCount}"
                                   FontWeight="Bold"
                                   FontSize="20"
                                   Foreground="#0F172A"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. Основна частина: Таблиця категорій + Діаграма -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Ліва частина: Таблиця топ витрат -->
                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Топ категорії витрат"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"/>
                            <TextBlock Text="{Binding CurrentPeriodText, StringFormat='Період: {0}'}"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding TopExpenseCategories}"
                                  AutoGenerateColumns="False"
                                  CanUserResizeColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Категорія"
                                                    Binding="{Binding Name}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Сума"
                                                    Binding="{Binding Amount, StringFormat='{}{0:N2} ₴'}"
                                                    Width="130"/>

                                <DataGridTextColumn Header="Частка"
                                                    Binding="{Binding Percentage, StringFormat='{}{0:F1}%'}"
                                                    Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Права частина: Діаграма структури -->
                <Border Grid.Column="1"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Структура витрат"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,10"/>

                        <lvc:PieChart Grid.Row="1"
                                      Series="{Binding ExpenseSeries}"
                                      Height="280"
                                      LegendLocation="Bottom"
                                      Margin="0,10,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. Блок місячних бюджетів та лімітів витрат -->
            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18"
                    Margin="0,14,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Місячний бюджет та ліміти витрат"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"/>
                            <TextBlock Text="Контроль виконання запланованих витрат на поточний місяць"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Поточний місяць"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#4F46E5"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Список бюджетів -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding MonthlyBudgets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,8,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Рядок опису та сум -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding CategoryName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Foreground="#1E293B"/>

                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SpentAmount, StringFormat='{}{0:N0} ₴'}"
                                                           FontWeight="Bold"
                                                           FontSize="13"
                                                           Foreground="#0F172A"/>
                                                <TextBlock Text=" з "
                                                           Foreground="#94A3B8"
                                                           FontSize="12"/>
                                                <TextBlock Text="{Binding PlannedAmount, StringFormat='{}{0:N0} ₴'}"
                                                           FontWeight="Medium"
                                                           Foreground="#64748B"
                                                           FontSize="12"
                                                           Margin="0,0,10,0"/>

                                                <!-- Бейдж статусу -->
                                                <Border Background="#F1F5F9"
                                                        CornerRadius="4"
                                                        Padding="8,2">
                                                    <TextBlock Text="{Binding StatusBadgeText}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="#475569"/>
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Прогрес-бар виконання бюджету -->
                                        <ProgressBar Grid.Row="1"
                                                     Value="{Binding ProgressPercentage}"
                                                     Maximum="100"
                                                     Height="7"
                                                     Foreground="#4F46E5"
                                                     Background="#F1F5F9"
                                                     BorderThickness="0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
