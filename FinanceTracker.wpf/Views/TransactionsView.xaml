<UserControl x:Class="FinanceTracker.wpf.Views.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:FinanceTracker.wpf.ViewModels"
             xmlns:conv="clr-namespace:FinanceTracker.wpf.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             d:DesignHeight="550" d:DesignWidth="950">

    <UserControl.Resources>
        <conv:TransactionTypeToBrushConverter x:Key="TransactionTypeToBrushConverter"/>
        <conv:BalanceToBrushConverter x:Key="BalanceToBrushConverter"/>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <!-- Повнорозмірна біла картка для пошуку та таблиці -->
        <Border Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Панель пошуку і фільтрів -->
                    <RowDefinition Height="Auto"/>
                    <!-- Сама таблиця -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Панель фільтрації та пошуку -->
                <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
                    <!-- Ліва частина: Пошук + Очищення + Фільтр рахунку -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <!-- SVG Іконка пошуку -->
                        <Path Data="{StaticResource GeoSearch}"
                              Fill="#94A3B8"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"/>

                        <TextBox Width="240"
                                 Height="34"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Введіть текст для пошуку за описом чи категорією"
                                 VerticalContentAlignment="Center"/>

                        <!-- Кнопка очищення з SVG іконкою хрестика -->
                        <Button Width="32" Height="32" MinWidth="32"
                                Padding="0"
                                Margin="4,0,14,0"
                                ToolTip="Очистити пошук"
                                Style="{StaticResource PeriodButtonStyle}"
                                Command="{Binding ClearSearchCommand}">
                            <Path Data="{StaticResource GeoClose}"
                                  Fill="#64748B"
                                  Width="10" Height="10"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Button>

                        <!-- Фільтр за рахунком -->
                        <TextBlock Text="Рахунок:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Foreground="#64748B"
                                   FontSize="12"/>
                        <ComboBox Width="145"
                                  Height="34"
                                  ItemsSource="{Binding AccountFilterOptions}"
                                  SelectedItem="{Binding SelectedAccountFilter}"/>
                    </StackPanel>

                    <!-- Права частина: Лічильник знайденого -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="Знайдено записів: "
                                   Foreground="#64748B"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding FilteredTransactionsCount}"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   FontSize="12"/>
                    </StackPanel>
                </DockPanel>

                <!-- Таблиця транзакцій на всю висоту -->
                <DataGrid x:Name="TransactionsDataGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding FilteredTransactions}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <!-- Дата -->
                        <DataGridTextColumn Header="Дата"
                                            Binding="{Binding Date, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                            Width="135"/>

                        <!-- Опис -->
                        <DataGridTextColumn Header="Опис"
                                            Binding="{Binding Description}"
                                            Width="*"/>

                        <!-- Бейдж типу (Дохід / Витрата) -->
                        <DataGridTemplateColumn Header="Тип" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F1F5F9"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayType}"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   Foreground="{Binding IsIncome, Converter={StaticResource TransactionTypeToBrushConverter}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Категорія -->
                        <DataGridTextColumn Header="Категорія"
                                            Binding="{Binding Category.Name, TargetNullValue='—'}"
                                            Width="140"/>

                        <!-- Рахунок -->
                        <DataGridTextColumn Header="Рахунок"
                                            Binding="{Binding Account.Name}"
                                            Width="120"/>

                        <!-- Сума із кольоровим форматуванням -->
                        <DataGridTemplateColumn Header="Сума" Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedAmount}"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               HorizontalAlignment="Right"
                                               Foreground="{Binding IsIncome, Converter={StaticResource TransactionTypeToBrushConverter}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <!-- Контекстне меню -->
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Видалити транзакцію" Click="DeleteTransaction_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
