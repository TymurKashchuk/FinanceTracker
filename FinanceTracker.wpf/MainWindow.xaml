<Window x:Class="FinanceTracker.wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FinanceTracker.wpf.ViewModels"
        xmlns:views="clr-namespace:FinanceTracker.wpf.Views"
        xmlns:conv="clr-namespace:FinanceTracker.wpf.Converters"
        mc:Ignorable="d"
        Title="FinanceTracker — Особисті фінанси"
        Height="780"
        Width="1260"
        MinWidth="1100"
        MinHeight="660"
        Background="#F8FAFC"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Лівий сайдбар -->
            <ColumnDefinition Width="250"/>
            <!-- Основна робоча область -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. Сайдбар навігації та рахунків -->
        <views:SidebarView Grid.Column="0"/>

        <!-- 2. Основна робоча область -->
        <Grid Grid.Column="1" Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <!-- Верхня панель: Заголовок + Періоди -->
                <RowDefinition Height="Auto"/>
                <!-- Панель швидкого додавання операції -->
                <RowDefinition Height="Auto"/>
                <!-- Контент поточної сторінки -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 2.1. Верхній рядок: Заголовок + вибір періоду -->
            <views:TopBarView Grid.Row="0" Margin="0,0,0,14"/>

            <!-- 2.2. Форма швидкого додавання транзакції -->
            <views:QuickAddView Grid.Row="1" Margin="0,0,0,14"/>

            <!-- 2.3. Вміст активної сторінки -->
            <Grid Grid.Row="2">
                <!-- 1. Дашборд -->
                <views:HomeView Visibility="{Binding IsDashboardTab, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- 2. Транзакції -->
                <views:TransactionsView Visibility="{Binding IsTransactionsTab, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- 3. Аналітика -->
                <views:SummaryView Visibility="{Binding IsAnalyticsTab, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
